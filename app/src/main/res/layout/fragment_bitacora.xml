<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_bitacora"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:scrollbarThumbVertical="@color/primary_teal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Card: Perfil Personal y Fotografía (Rúbrica RF-02) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Fila con Foto de Perfil y Datos Personales Básicos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Fotografía de la Persona -->
                    <ImageView
                        android:id="@+id/img_perfil_foto"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_avatar_person"
                        android:contentDescription="Fotografía del Perfil" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_perfil_nombre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sandra Milena Millan Alvarez"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_perfil_rol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Ingeniera de Sistemas • Desarrolladora Android"
                            android:textColor="@color/primary_teal"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_perfil_institucion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Politécnico Grancolombiano • Bogotá, Colombia"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Selector Interactivo de Integrantes del Equipo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Seleccionar integrante del equipo para consultar perfil:"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_chip_sandra"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="Sandra Millan"
                            android:textSize="10sp"
                            style="@style/Widget.NativeSquad.Button.Primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_chip_miguel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="Miguel Mendoza"
                            android:textSize="10sp"
                            style="@style/Widget.NativeSquad.Button.Secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_chip_juan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="Juan Muñoz"
                            android:textSize="10sp"
                            style="@style/Widget.NativeSquad.Button.Secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_chip_julio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Julio Murillo"
                            android:textSize="10sp"
                            style="@style/Widget.NativeSquad.Button.Secondary" />

                    </LinearLayout>
                </HorizontalScrollView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card: ESTUDIOS Y FORMACIÓN ACADÉMICA (Con ScrollView interna para optimizar pantalla) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="14dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🎓 Estudios y Formación Académica"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:text="Scroll activo"
                        android:textColor="@color/primary_teal"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Campo tipo texto optimizado con barra de desplazamiento vertical:"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />

                <!-- Contenedor con ScrollView vertical dedicada para optimizar la pantalla -->
                <ScrollView
                    android:id="@+id/scroll_estudios"
                    android:layout_width="match_parent"
                    android:layout_height="115dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/bg_input"
                    android:padding="10dp"
                    android:scrollbars="vertical"
                    android:scrollbarThumbVertical="@color/primary_teal">

                    <TextView
                        android:id="@+id/tv_perfil_estudios"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="• Ingeniería de Sistemas - Institución Universitaria Politécnico Grancolombiano (En curso, 2023 - 2026).\n\n• Diplomado en Arquitectura de Software y Desarrollo de Soluciones Móviles (Politécnico Grancolombiano, 2026).\n\n• Certificación Oficial: Google Developers - Android Basics in Java &amp; Kotlin (2025).\n\n• Curso Especializado en Diseño de Interfaces Móviles (UI/UX) con Google Material Design 3 (2025).\n\n• Certificado en Fundamentos de Bases de Datos Relacionales y SQLite/Room para Android (2024)."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                </ScrollView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card: EXPERIENCIA PROFESIONAL Y PROYECTOS (Con ScrollView interna para optimizar pantalla) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="14dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💼 Experiencia Profesional &amp; Proyectos"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:text="Scroll activo"
                        android:textColor="@color/primary_teal"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Campo tipo texto optimizado con barra de desplazamiento vertical:"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />

                <!-- Contenedor con ScrollView vertical dedicada para optimizar la pantalla -->
                <ScrollView
                    android:id="@+id/scroll_experiencia"
                    android:layout_width="match_parent"
                    android:layout_height="115dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/bg_input"
                    android:padding="10dp"
                    android:scrollbars="vertical"
                    android:scrollbarThumbVertical="@color/accent_coral">

                    <TextView
                        android:id="@+id/tv_perfil_experiencia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="• Desarrolladora Android Líder - NativeSquad HPM (2026):\nImplementación de la arquitectura modular de doble fragmento sincronizado, integración de controladores multimedia (VideoView y MediaController), navegador WebView interno y gestión de eventos de interfaz táctil.\n\n• Ingeniera de Software Junior - Soluciones Móviles (2025 - Presente):\nDiseño y maquetación de interfaces responsivas con LinearLayout, ConstraintLayout y CardView. Aplicación de buenas prácticas de ciclo de vida en Android.\n\n• Desarrolladora Full-Stack en Proyectos Académicos Poli (2024 - 2025):\nConstrucción de aplicaciones distribuidas, consumo de APIs RESTful, diseño de modelos relacionales y flujos colaborativos Git/GitHub."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                </ScrollView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card: BIOGRAFÍA EXTENSA Y ENFOQUE PROFESIONAL -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="14dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 Biografía &amp; Perfil Profesional"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ScrollView
                    android:id="@+id/scroll_biografia"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/bg_input"
                    android:padding="8dp"
                    android:scrollbars="vertical"
                    android:scrollbarThumbVertical="@color/accent_blue">

                    <TextView
                        android:id="@+id/tv_perfil_biografia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="Profesional proactiva con sólida formación en ingeniería de sistemas, especializada en el desarrollo de software nativo para plataformas móviles y ecoturismo sostenible. Apasionada por diseñar experiencias intuitivas, arquitecturas limpias y código altamente mantenible que resuelvan necesidades reales en la comunidad."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                </ScrollView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card: Métricas e Identidad del Proyecto NativeSquad HPM -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="14dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 Estadísticas del Expedicionario &amp; Proyecto"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_destinations_val"
                            android:textColor="@color/primary_teal"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_destinations_lbl"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_routes_val"
                            android:textColor="@color/accent_coral"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_routes_lbl"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_rating_val"
                            android:textColor="@color/accent_amber"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_rating_lbl"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_guides_val"
                            android:textColor="@color/accent_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_guides_lbl"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Botón de interacción en Perfil -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_bitacora_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="📄 Descargar Hoja de Vida / Ficha de Perfil"
                    style="@style/Widget.NativeSquad.Button.Primary" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
