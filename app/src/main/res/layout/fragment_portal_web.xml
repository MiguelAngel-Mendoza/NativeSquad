<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="12dp">

    <!-- Encabezado del Módulo Web -->
    <TextView
        android:id="@+id/tv_portal_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/portal_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_portal_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/portal_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:layout_marginBottom="10dp" />

    <!-- Barra de Búsqueda y Navegación de URL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_box"
        android:padding="4dp"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_search"
            android:tint="@color/text_muted"
            android:contentDescription="Buscar" />

        <EditText
            android:id="@+id/et_url_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@null"
            android:hint="@string/portal_url_hint"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:padding="8dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cargar_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/portal_btn_go"
            android:textSize="11sp"
            style="@style/Widget.NativeSquad.Button.Primary" />
    </LinearLayout>

    <!-- Accesos Rápidos a Portales de Turismo (Bookmarks) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_colombia_travel"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:text="Colombia.travel"
                android:textSize="10sp"
                style="@style/Widget.NativeSquad.Button.Secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_parques_nacionales"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:text="Parques Nacionales"
                android:textSize="10sp"
                style="@style/Widget.NativeSquad.Button.Secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_wiki_turismo"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:text="Wikipedia Turismo"
                android:textSize="10sp"
                style="@style/Widget.NativeSquad.Button.Secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_politecnico"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Politécnico Grancolombiano"
                android:textSize="10sp"
                style="@style/Widget.NativeSquad.Button.Secondary" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Barra de progreso de carga web -->
    <ProgressBar
        android:id="@+id/progress_web_loading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:progressTint="@color/primary_teal"
        android:visibility="gone" />

    <!-- Barra de controles de navegación web (Atrás, Adelante, Recargar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp"
        android:background="@color/bg_card"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btn_web_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_primary"
            android:contentDescription="Atrás" />

        <ImageButton
            android:id="@+id/btn_web_forward"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_forward"
            android:tint="@color/text_primary"
            android:contentDescription="Adelante" />

        <ImageButton
            android:id="@+id/btn_web_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_refresh"
            android:tint="@color/primary_teal"
            android:contentDescription="Recargar" />

        <TextView
            android:id="@+id/tv_web_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:text="Listo"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Contenedor del WebView embebido -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.cardview.widget.CardView>

</LinearLayout>
