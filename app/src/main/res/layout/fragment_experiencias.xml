<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Encabezado del Módulo de Video -->
        <TextView
            android:id="@+id/tv_experiencias_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/experiencias_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_experiencias_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/experiencias_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginBottom="12dp" />

        <!-- Contenedor del Reproductor de Video (VideoView) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/black"
            app:cardCornerRadius="14dp"
            app:cardElevation="6dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="180dp">

                <VideoView
                    android:id="@+id/video_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true" />

                <!-- Indicador de carga / buffering -->
                <ProgressBar
                    android:id="@+id/progress_video_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:indeterminateTint="@color/primary_teal"
                    android:visibility="gone" />

                <!-- Overlay de estado -->
                <TextView
                    android:id="@+id/tv_video_status_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="8dp"
                    android:background="#80000000"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Listo para reproducir"
                    android:textColor="@color/white"
                    android:textSize="10sp" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Controles de Reproducción Personalizados (Play, Pausa, Reiniciar) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_video_play"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:paddingHorizontal="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Play"
                android:textSize="11sp"
                android:singleLine="true"
                app:icon="@drawable/ic_play"
                app:iconSize="16dp"
                app:iconPadding="4dp"
                app:iconGravity="textStart"
                app:iconTint="@color/text_on_primary"
                style="@style/Widget.NativeSquad.Button.Primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_video_pause"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:paddingHorizontal="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Pausa"
                android:textSize="11sp"
                android:singleLine="true"
                app:icon="@drawable/ic_pause"
                app:iconSize="16dp"
                app:iconPadding="4dp"
                app:iconGravity="textStart"
                app:iconTint="@color/primary_teal"
                style="@style/Widget.NativeSquad.Button.Secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_video_replay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Reinicio"
                android:textSize="11sp"
                android:singleLine="true"
                app:icon="@drawable/ic_replay"
                app:iconSize="16dp"
                app:iconPadding="4dp"
                app:iconGravity="textStart"
                app:iconTint="@color/primary_teal"
                style="@style/Widget.NativeSquad.Button.Secondary" />
        </LinearLayout>

        <!-- Selector de Clips / Experiencias en Video -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selecciona una Experiencia:"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clip_colombia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:paddingHorizontal="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Colombia"
                android:textSize="10sp"
                android:singleLine="true"
                style="@style/Widget.NativeSquad.Button.Secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clip_cafetero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:paddingHorizontal="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Cafetero"
                android:textSize="10sp"
                android:singleLine="true"
                style="@style/Widget.NativeSquad.Button.Secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clip_caribe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Caribe"
                android:textSize="10sp"
                android:singleLine="true"
                style="@style/Widget.NativeSquad.Button.Secondary" />
        </LinearLayout>

        <!-- Información del Cortometraje / Experiencia Activa -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tv_video_active_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Experiencia 01: Colombia, País de la Belleza"
                    android:textColor="@color/primary_teal"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_video_active_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Un recorrido audiovisual de alta definición por los 5 pisos térmicos de Colombia, registrando la biodiversidad de la Sierra Nevada, las murallas históricas de Cartagena y la cultura de los cafetales."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
