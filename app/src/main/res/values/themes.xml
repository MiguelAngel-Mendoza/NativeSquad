<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.NativeSquad.GuiaDeViajes" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_teal</item>
        <item name="colorPrimaryVariant">@color/primary_teal_variant</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent_coral</item>
        <item name="colorSecondaryVariant">@color/accent_amber</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar and Navigation bar color. -->
        <item name="android:statusBarColor">@color/bg_menu</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:windowBackground">@color/bg_main</item>
    </style>

    <!-- Custom Button Styles -->
    <style name="Widget.NativeSquad.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary_teal</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.NativeSquad.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/primary_teal</item>
        <item name="android:textColor">@color/primary_teal</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.NativeSquad.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">3dp</item>
    </style>
</resources>
